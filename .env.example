# Copy to .env.local and fill in. Never commit real keys.

# --- Voice, translation and read-aloud (Sarvam AI, https://docs.sarvam.ai) ---
# Server-side only. Without it, text chat still works and voice offers a demo mode.
# Seva Saathi does not store audio. Configure retention in your Sarvam account (see docs.sarvam.ai).
SARVAM_API_KEY=
# Optional model overrides (defaults shown)
# SARVAM_STT_MODEL=saaras:v4
# SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=shubh
# SARVAM_BASE_URL=https://api.sarvam.ai

# --- Assistant answer composer ---
# "mock" (default) is the deterministic, no-LLM matcher.
# "openai-compatible" uses any OpenAI-style chat completions API with the vars below.
ASSISTANT_PROVIDER=mock
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- Postgres (optional). App falls back to file data when unset. ---
# Local Docker Compose: postgresql://seva:seva_local@127.0.0.1:5433/seva_saathi
# DATABASE_URL=

# --- Embeddings for ingestion / hybrid retrieval (optional) ---
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
# EMBEDDING_MODEL=text-embedding-3-small

# --- API logging (privacy-safe: hashed client id only) ---
# LOG_API_EVENTS=1

# --- Latest updates feed ---
# PIB's CDN rejects non-browser user agents; override here if needed.
# FEED_USER_AGENT=
